<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ilari.ai-limits-widget</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ilari/projects/utilities/widgets/bin/widget.sh</string>
  </array>

  <!-- launchd gives a bare PATH, so every tool is listed here.
       No nvm node directory is listed, because its name changes with each
       node update. lib/read-alibaba.sh finds bailian-cli in nvm itself. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/ilari/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/ai-limits-widget.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ai-limits-widget.err</string>
</dict>
</plist>
